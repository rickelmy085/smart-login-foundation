# Copie para .env e ajuste conforme necessário.

# Porta do servidor HTTP
PORT=8081

# Caminho do banco SQLite. Use o mesmo caminho para o servidor e o CLI `cmd/ingest`.
# Default (relativo): ./data/abis.db
DATABASE_PATH=./backend/data/abis.db

# Segredo usado para assinar tokens JWT. Troque em produção!
JWT_SECRET=change-me-in-env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b