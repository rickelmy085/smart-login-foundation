# Copie para .env e ajuste conforme necessário.

# Porta do servidor HTTP
PORT=8081

# Caminho do banco SQLite. Use o mesmo caminho para o servidor e o CLI `cmd/ingest`.
# Default (relativo): ./data/abis.db
DATABASE_PATH=./backend/data/abis.db

# Segredo usado para assinar tokens JWT. Troque em produção!
JWT_SECRET=change-me-in-env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Document Engine Python (Fase 2)
DOCUMENT_ENGINE_ENABLED=false
DOCUMENT_ENGINE_URL=http://127.0.0.1:8090
DOCUMENT_ENGINE_INTERNAL_SECRET=change-me
DOCUMENT_ENGINE_TIMEOUT_SECONDS=30
DOCUMENT_ENGINE_FALLBACK_TO_GO=true